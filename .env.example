# Copy this file to `.env` and fill in your keys. Never commit `.env`.
# Stack (see .cursorrules): ElevenLabs (audio), ComfyUI (images), FFmpeg (video).

# --- Voiceover: ElevenLabs API ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional. Defaults to eleven_multilingual_v2.
ELEVENLABS_MODEL_ID=

# --- Image generation: ComfyUI API ---
# Base URL of a running ComfyUI server.
COMFYUI_URL=http://127.0.0.1:8188
# Checkpoint filename as listed in ComfyUI's models/checkpoints directory.
COMFYUI_CHECKPOINT=
# Optional. Path to a ComfyUI API-format workflow JSON. It must contain the
# literal placeholders __PROMPT__, __NEGATIVE_PROMPT__ and __SEED__ (see
# src/image_generator.py). Leave blank to use the built-in txt2img workflow.
COMFYUI_WORKFLOW=

# --- Video rendering: FFmpeg ---
# Optional. Override if ffmpeg/ffprobe are not on PATH.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# --- YouTube upload (OAuth 2.0) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# --- Pipeline settings ---
# Where generated assets are written (relative to the project root).
OUTPUT_DIR=output
# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
