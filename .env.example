# Copy this file to `.env` and fill in your keys. Never commit `.env`.

# --- Script generation (LLM) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Voiceover / text-to-speech ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Image generation ---
STABILITY_API_KEY=
REPLICATE_API_TOKEN=

# --- Stock footage / music (optional) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- YouTube upload (OAuth 2.0) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# --- Pipeline settings ---
# Where generated assets are written (relative to the project root).
OUTPUT_DIR=output
# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
