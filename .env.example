# Copy to .env (gitignored). `python -m gi_radio ...` loads it automatically.

# ElevenLabs — https://elevenlabs.io -> profile -> API Keys
ELEVENLABS_API_KEY=
# Optional overrides; defaults are premade voices (Bill for the narrator, Sarah for Hannah)
ELEVENLABS_NARRATOR_VOICE_ID=
ELEVENLABS_HANNAH_VOICE_ID=

# ComfyUI — either a local server...
COMFYUI_URL=http://127.0.0.1:8188
# ...or Comfy Cloud: key from https://platform.comfy.org/profile/api-keys (Standard/Creator/Pro plan).
# When COMFYUI_API_KEY is set and COMFYUI_URL is empty, https://cloud.comfy.org is used.
COMFYUI_API_KEY=
# Must exist on the target server. Comfy Cloud has sd_xl_base_1.0.safetensors,
# Juggernaut-XL_v9_RunDiffusionPhoto_v2.safetensors, realvisxlV50_v50Bakedvae.safetensors, ...
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
